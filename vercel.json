      "destination": "/privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/uso-responsable",
      "destination": "/uso-responsable.html"
    },
    {
      "source": "/verifica-correo",
      "destination": "/verifica-correo.html"
